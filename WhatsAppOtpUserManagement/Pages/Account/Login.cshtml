@page
@model WhatsAppOtpIdentityServer.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h2>Log in with WhatsApp</h2>

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<form method="post">
    <div>
        <label asp-for="Input.PhoneNumber">Phone number (E.164, e.g. +15551234567)</label>
        <input asp-for="Input.PhoneNumber" type="tel" required autofocus autocomplete="tel" placeholder="+15551234567" />
        <span asp-validation-for="Input.PhoneNumber"></span>
    </div>
    <button type="submit">Send one-time password via WhatsApp</button>
</form>
